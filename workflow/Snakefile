# =====================================================================
# Pipeline: mineria de metalorreguladores (BITACORA -> MetalNet2 -> analisis)
#
# Correr (en el server, dentro del env 'smk'):
#   conda activate smk
#   snakemake -n                                  # dry-run: valida el DAG
#   snakemake --use-conda --cores 10              # ejecuta
# Solo una etapa:
#   snakemake --use-conda --cores 10 results/bitacora/MtubH37Rv
# =====================================================================

import pandas as pd
from pathlib import Path

configfile: "config/config.yaml"

samples = pd.read_table("config/samples.tsv").set_index("sample", drop=False)
SAMPLES = samples["sample"].tolist()


# ---------- Objetivo final ----------
rule all:
    input:
        "results/tables/metalnet_sites_annotated.tsv",
        "results/figures/sites_per_family.png",


# ---------- Etapa 1: BITACORA (genome/full mode), una corrida por muestra ----------
# Usa workflow/scripts/runBITACORA_templated.sh, que es tu runBITACORA.sh v1.4 pero
# leyendo la config de variables de entorno. La regla entra al directorio de salida
# de la muestra y corre BITACORA ahi, para que las carpetas por familia queden
# dentro de results/bitacora/{sample}/<FAMILIA>/.
rule bitacora:
    input:
        genome   = lambda wc: samples.loc[wc.sample, "genome_fasta"],
        gff      = lambda wc: samples.loc[wc.sample, "genome_gff"],
        proteins = lambda wc: samples.loc[wc.sample, "proteins_fasta"],
        query_db = config["query_db"],
    output:
        outdir = directory("results/bitacora/{sample}"),
    params:
        scriptdir       = config["bitacora_scriptdir"],
        gemomap         = config["bitacora_gemomap"],
        evalue          = lambda wc: samples.loc[wc.sample, "evalue"],
        gemoma          = config["bitacora_gemoma"],
        maxintron       = config["bitacora_maxintron"],
        genomicblastp   = config["bitacora_genomicblastp"],
        addfilter       = config["bitacora_addfilter"],
        filterlength    = config["bitacora_filterlength"],
        retainnonfilter = config["bitacora_retainnonfilter"],
        clean           = config["bitacora_clean"],
    threads:
        config["bitacora_threads"]
    conda:
        "envs/bitacora.yaml"
    log:
        "logs/bitacora/{sample}.log"
    shell:
        r"""
        repo=$(pwd)
        genome=$(realpath {input.genome})
        gff=$(realpath {input.gff})
        prot=$(realpath {input.proteins})
        qdir=$(realpath {input.query_db})

        mkdir -p {output.outdir}
        cd {output.outdir}

        export SCRIPTDIR="{params.scriptdir}"
        export GEMOMAP="{params.gemomap}"
        export NAME="{wildcards.sample}"
        export GENOME="$genome"
        export GFFFILE="$gff"
        export PROTFILE="$prot"
        export QUERYDIR="$qdir"
        export EVALUE="{params.evalue}"
        export THREADS="{threads}"
        export GEMOMA="{params.gemoma}"
        export MAXINTRON="{params.maxintron}"
        export GENOMICBLASTP="{params.genomicblastp}"
        export ADDFILTER="{params.addfilter}"
        export FILTERLENGTH="{params.filterlength}"
        export RETAINNONFILTER="{params.retainnonfilter}"
        export CLEAN="{params.clean}"

        bash "$repo/workflow/scripts/runBITACORA_templated.sh" 2>&1 | tee "$repo/{log}"
        """


# ---------- Etapa 2: recolectar candidatos para MetalNet2 ----------
# Junta todos los *_idseqsclustered.fasta (todas las familias, todas las muestras)
# en un solo candidates.fasta, con headers: >muestra|familia|id_original
rule collect_candidates:
    input:
        dirs = expand("results/bitacora/{sample}", sample=SAMPLES),
    output:
        fasta = "results/metalnet/input/candidates.fasta",
        prov  = "results/metalnet/input/provenance.tsv",
    params:
        suffix = config["bitacora_keep_suffix"],
    conda:
        "envs/analysis.yaml"
    log:
        "logs/collect_candidates.log"
    script:
        "scripts/collect_candidates.py"


# ---------- Etapa 3: MetalNet2 (ColabFold) ----------
# Usa tu entorno ya funcional por ruta absoluta (config.yaml). NO lleva 'conda:'.
rule metalnet:
    input:
        fasta = "results/metalnet/input/candidates.fasta",
    output:
        pairs = "results/metalnet/output/pred_pairs.tsv",
    params:
        py     = config["metalnet_python"],
        script = config["metalnet_script"],
        msa    = config["metalnet_msa_source"],
        gpu    = 1 if config["metalnet_use_gpu"] else 0,
    threads:
        config["metalnet_threads"]
    log:
        "logs/metalnet.log"
    shell:
        r"""
        bash workflow/scripts/run_metalnet_colabfold.sh \
            "{params.py}" "{params.script}" \
            "{input.fasta}" "{output.pairs}" \
            "{params.msa}" {threads} {params.gpu} \
            2>&1 | tee {log}
        """


# ---------- Etapa 4: anotar la salida de MetalNet2 ----------
rule parse_metalnet:
    input:
        pairs = "results/metalnet/output/pred_pairs.tsv",
        prov  = "results/metalnet/input/provenance.tsv",
    output:
        table = "results/tables/metalnet_sites_annotated.tsv",
    conda:
        "envs/analysis.yaml"
    log:
        "logs/parse_metalnet.log"
    script:
        "scripts/parse_metalnet.py"


# ---------- Etapa 5: figuras ----------
rule plots:
    input:
        table = "results/tables/metalnet_sites_annotated.tsv",
    output:
        "results/figures/sites_per_family.png",
    conda:
        "envs/analysis.yaml"
    log:
        "logs/plots.log"
    script:
        "scripts/plots.py"
